# Copy to .env and uncomment ONE profile.

# --- Local SLM via Ollama (default) ---
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=phi4-mini
LLM_RESPONSE_FORMAT=json_object

# --- Azure Foundry: Phi / Llama / Mistral / GPT deployments (OpenAI v1-compatible endpoint) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1/
# LLM_API_KEY=<foundry-key>
# LLM_MODEL=<deployment-name>
# LLM_RESPONSE_FORMAT=json_schema

# --- Claude on Azure Foundry ---
# LLM_PROVIDER=anthropic_foundry
# ANTHROPIC_FOUNDRY_RESOURCE=<your-resource>
# LLM_API_KEY=<foundry-key>
# LLM_MODEL=claude-haiku-5-5

# --- Claude via the Anthropic API ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=<anthropic-key>
# LLM_MODEL=claude-haiku-5-5

# Optional tuning
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_TOKENS=128
# ANTHROPIC_EFFORT=low
# FALLBACK_ROUTE=Keyword Search
